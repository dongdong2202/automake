/* pages/product-detail/product-detail.wxss */

.product-detail-page {
  padding-bottom: 0;
  background-color: var(--color-bg-page);
}

/* ============================================================
   1. 商品主图 (750rpx × 750rpx)
   ============================================================ */
.product-hero-wrap {
  width: 750rpx;
  height: 750rpx;
  background: #f7faf8;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.hero-image {
  width: 750rpx;
  height: 750rpx;
  display: block;
}

.hero-tag-pill {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(10px);
  padding: 8rpx 20rpx;
  border-radius: var(--radius-full);
  font-size: 22rpx;
  color: var(--color-primary-dark);
  font-weight: 700;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.06);
  align-items: center;
}

.hero-tag-dot {
  width: 12rpx;
  height: 12rpx;
  background-color: var(--color-primary);
  border-radius: 50%;
  margin-right: 8rpx;
}

/* ============================================================
   2. 商品基础信息卡片 (商品名称 + 商品说明)
   ============================================================ */
.product-info-card {
  margin: 20rpx 24rpx 16rpx 24rpx;
  border-radius: var(--radius-md);
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(44, 53, 46, 0.05);
}

.info-header {
  align-items: center;
  margin-bottom: 12rpx;
}

.product-title {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--color-text-main);
  letter-spacing: 0.5rpx;
}

.product-badge {
  font-size: 20rpx;
  color: var(--color-primary);
  background-color: var(--color-primary-light);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-full);
  font-weight: 700;
}

.product-desc {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.55;
  display: block;
}

.ingredients-line {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed var(--color-border-dark);
  font-size: 22rpx;
  line-height: 1.45;
}

.ing-label {
  font-weight: 700;
  color: var(--color-primary-dark);
}

.ing-val {
  color: var(--color-text-main);
}

/* ============================================================
   3. 专属定制卡片 (Custom Card)
   ============================================================ */
.custom-card {
  margin: 0 24rpx 20rpx 24rpx;
  border-radius: var(--radius-md);
  box-shadow: 0 4rpx 16rpx rgba(44, 53, 46, 0.05);
  padding: 24rpx;
}

.custom-section-title {
  align-items: baseline;
  padding-bottom: 18rpx;
  border-bottom: 1rpx dashed var(--color-border-dark);
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-text-main);
}

.price-main {
  align-items: baseline;
}

.price-unit-tag {
  font-size: 22rpx;
  color: var(--color-text-muted);
  margin-left: 6rpx;
}

/* SKU 规格选项 */
.sku-group-box {
  margin-bottom: 22rpx;
}

.group-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text-main);
  margin-bottom: 12rpx;
  display: block;
}

.sku-chips-wrap {
  flex-wrap: wrap;
  gap: 12rpx;
}

.sku-chip {
  height: 58rpx;
  padding: 0 24rpx;
  background-color: var(--color-bg-subtle);
  border: 1.5rpx solid transparent;
  border-radius: var(--radius-sm);
  font-size: 24rpx;
  color: var(--color-text-secondary);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transition: all 0.15s ease;
}

.sku-chip.active {
  background-color: var(--color-primary-light);
  border-color: var(--color-primary);
  color: var(--color-primary);
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(75, 99, 84, 0.12);
}

.chip-name {
  font-size: 24rpx;
}

.chip-delta {
  font-size: 20rpx;
  margin-left: 6rpx;
  font-weight: 600;
  color: var(--color-secondary);
}

.sku-chip.active .chip-delta {
  color: var(--color-primary);
}

.step-btn.disabled {
  opacity: 0.35;
  pointer-events: none;
}

/* ============================================================
   4. 详情页 (detail_page 宽度 750rpx)
   ============================================================ */
.detail-page-card {
  width: 750rpx;
  margin: 0;
  padding: 0;
  display: block;
  line-height: 0;
  overflow: hidden;
}

.detail-page-img {
  width: 750rpx;
  width: 100%;
  display: block;
  vertical-align: bottom;
}

/* ============================================================
   5. 购买数量与购物车结算卡片 (紧接详情页图片结束处)
   ============================================================ */
.detail-checkout-card {
  margin: 0;
  border-radius: 0;
  background: #ffffff;
  padding: 28rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)) 32rpx;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.05);
  border-top: 1rpx solid var(--color-border-dark);
}

.quantity-row {
  align-items: center;
  padding-bottom: 24rpx;
  border-bottom: 1rpx dashed var(--color-border-dark);
  margin-bottom: 24rpx;
}

.quantity-title {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-text-main);
  margin-bottom: 4rpx;
}

.quantity-sub {
  font-size: 20rpx;
  color: var(--color-text-muted);
}

.bottom-action-buttons {
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
  width: 100%;
}

/* 加入购物车 (较小、次级按钮) */
.btn-detail-cart {
  flex: 1;
  height: 74rpx;
  border: 1.5rpx solid var(--color-primary);
  color: var(--color-primary);
  background-color: #ffffff;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transition: all 0.15s ease;
}

.cart-btn-icon {
  font-size: 26rpx;
  margin-right: 6rpx;
}

.cart-btn-text {
  font-size: 24rpx;
  font-weight: 600;
}

/* 立即购买 (明显更大更醒目主按钮) */
.btn-detail-buy {
  flex: 1.85;
  height: 88rpx;
  background: var(--color-primary-gradient);
  color: #ffffff;
  border-radius: var(--radius-full);
  box-shadow: 0 6rpx 20rpx rgba(75, 99, 84, 0.32);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transition: all 0.15s ease;
}

.buy-btn-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.buy-btn-text {
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 0.5rpx;
}

.btn-sub-price {
  font-size: 28rpx;
  margin-left: 10rpx;
  font-weight: 800;
  opacity: 0.98;
  font-family: 'DIN Alternate', -apple-system, sans-serif;
}



