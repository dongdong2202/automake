/* pages/coupon/coupon.wxss */

.coupon-page {
  padding: 0 0 40rpx 0;
}

.coupon-tabs-wrap {
  background-color: #ffffff;
  padding: 0 20rpx;
  justify-content: space-around;
  border-bottom: 1rpx solid #f1f5f9;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  padding: 24rpx 16rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
}

.tab-item.active {
  color: var(--primary-color);
  font-weight: 700;
  border-bottom: 4rpx solid var(--primary-color);
}

.coupon-list-body {
  padding: 24rpx 28rpx;
}

.coupon-item {
  padding: 24rpx 20rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #f1f5f9;
}

.coupon-item.disabled {
  opacity: 0.5;
  filter: grayscale(80%);
}

.coupon-left {
  align-items: center;
  flex: 1;
}

.amount-box {
  min-width: 140rpx;
  padding-right: 20rpx;
  border-right: 1rpx dashed #e2e8f0;
}

.amount-num {
  font-size: 40rpx;
  font-weight: 900;
  color: var(--primary-color);
  font-family: 'DIN Alternate', -apple-system, sans-serif;
}

.amount-type {
  font-size: 20rpx;
  color: var(--text-muted);
}

.coupon-meta {
  padding-left: 20rpx;
}

.coupon-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
}

.coupon-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
}

.coupon-validity {
  font-size: 20rpx;
  color: var(--text-muted);
  margin-top: 6rpx;
}

.status-tag {
  font-size: 24rpx;
  color: var(--text-muted);
  font-weight: 500;
}
