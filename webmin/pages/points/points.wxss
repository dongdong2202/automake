/* pages/points/points.wxss */

.points-page {
  padding: 20rpx 28rpx;
}

.points-hero-card {
  padding: 36rpx 28rpx;
  background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
  color: #ffffff;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
}

.hero-label {
  font-size: 26rpx;
  color: #94a3b8;
}

.hero-points {
  font-size: 64rpx;
  font-weight: 900;
  color: #fbbf24;
  font-family: 'DIN Alternate', -apple-system, sans-serif;
  margin: 6rpx 0;
}

.hero-sub {
  font-size: 22rpx;
  color: #64748b;
}

.hero-badge {
  background-color: rgba(255, 255, 255, 0.1);
  padding: 16rpx 24rpx;
  border-radius: 20rpx;
}

.badge-icon {
  font-size: 40rpx;
  margin-bottom: 6rpx;
}

.badge-title {
  font-size: 22rpx;
  color: #fbbf24;
  font-weight: 600;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-bottom: 20rpx;
  display: block;
}

.reward-item, .log-item {
  padding: 18rpx 0;
  border-bottom: 1rpx dashed #f1f5f9;
}

.reward-item:last-child, .log-item:last-child {
  border-bottom: none;
}

.reward-title, .log-action {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

.reward-cost, .log-time {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.text-green {
  color: var(--secondary-color);
  font-weight: 700;
  font-size: 30rpx;
}

.text-danger {
  color: var(--danger-color);
  font-weight: 700;
  font-size: 30rpx;
}

.text-orange {
  color: var(--primary-color);
}
