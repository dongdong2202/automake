/* pages/staff/staff.wxss */

.staff-page {
  padding: 20rpx 28rpx;
}

/* 角色切换 */
.role-switch-wrap {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 8rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.role-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-secondary);
  border-radius: 16rpx;
}

.role-tab.active {
  background-color: var(--primary-color);
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 0, 0.25);
}

/* 设备选择器 */
.device-picker-card {
  margin-bottom: 20rpx;
}

.device-name-text {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
  margin-right: 8rpx;
}

.arrow-down {
  font-size: 20rpx;
  color: var(--text-muted);
}

.device-meta-text {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 6rpx;
}

.device-status-row {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed #f1f5f9;
  font-size: 22rpx;
}

.status-indicator.online {
  color: var(--secondary-color);
  font-weight: 600;
}

.status-indicator.offline {
  color: var(--danger-color);
}

.heartbeat-text {
  color: var(--text-muted);
}

/* 耗材补料表格 */
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
}

.tip-text {
  font-size: 22rpx;
  color: var(--text-muted);
}

.consumable-table {
  background-color: #f8fafc;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
}

.table-header {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary);
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #e2e8f0;
}

.col-name {
  flex: 2;
}

.col-curr {
  flex: 1.5;
  justify-content: center;
}

.col-input {
  flex: 2;
  justify-content: flex-end;
  align-items: center;
}

.table-row {
  padding: 16rpx 0;
  border-bottom: 1rpx dashed #e2e8f0;
  align-items: center;
}

.table-row:last-child {
  border-bottom: none;
}

.warning-row {
  background-color: #fffbeb;
}

.c-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-main);
}

.c-code {
  font-size: 20rpx;
  color: var(--text-muted);
}

.curr-num {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
}

.curr-unit, .input-unit {
  font-size: 22rpx;
  color: var(--text-muted);
  margin-left: 4rpx;
}

.stock-input {
  width: 140rpx;
  background-color: #ffffff;
  border: 2rpx solid #cbd5e1;
  border-radius: 10rpx;
  padding: 8rpx 14rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary-color);
}

.btn-save-stock {
  width: 100%;
  font-size: 30rpx;
  padding: 22rpx 0;
}

/* 协调员操作按钮网格 */
.action-buttons-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 20rpx;
}

.btn-action-card {
  padding: 24rpx 12rpx;
  border-radius: 16rpx;
  border: none;
  line-height: 1.4;
}

.bg-orange-light { background-color: #fff7ed; color: #c2410c; }
.bg-green-light { background-color: #ecfdf5; color: #047857; }
.bg-blue-light { background-color: #eff6ff; color: #1d4ed8; }

.action-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.action-title {
  font-size: 24rpx;
  font-weight: 700;
}

.action-desc {
  font-size: 18rpx;
  opacity: 0.8;
  margin-top: 4rpx;
}

/* 料桶高度列表 */
.materials-list {
  margin-top: 16rpx;
}

.material-item {
  padding: 16rpx 0;
  border-bottom: 1rpx dashed #f1f5f9;
}

.m-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-main);
}

.m-code {
  font-size: 20rpx;
  color: var(--text-muted);
}

.m-height {
  font-size: 28rpx;
  font-weight: 700;
}

.text-green { color: var(--secondary-color); }
.text-danger { color: var(--danger-color); }

.m-warn-tip {
  font-size: 20rpx;
  color: var(--danger-color);
}
