/* pages/cart/cart.wxss */

.cart-page {
  padding: 20rpx 28rpx 240rpx 28rpx;
}

.btn-go-order {
  margin-top: 32rpx;
  padding: 16rpx 60rpx;
}

/* 顶部门店卡片 */
.store-card {
  border-left: 8rpx solid var(--color-primary);
  background: linear-gradient(180deg, #ffffff 0%, #fffbf8 100%);
}

.store-name {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--color-text-main);
  margin-left: 12rpx;
}

.store-address {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 10rpx;
}

.store-badge {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-secondary);
  background-color: var(--color-secondary-light);
  padding: 6rpx 14rpx;
  border-radius: var(--radius-sm);
}

/* 商品清单卡片 */
.goods-header {
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
}

.clear-btn {
  font-size: 24rpx;
  color: var(--text-muted);
}

.clear-icon {
  margin-right: 4rpx;
}

.goods-item-row {
  padding: 24rpx 0;
  border-bottom: 1rpx dashed #f1f5f9;
}

.goods-thumb {
  width: 130rpx;
  height: 130rpx;
  border-radius: 14rpx;
  background-color: #f1f5f9;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.goods-main {
  flex: 1;
  min-height: 130rpx;
  justify-content: space-between;
  padding-right: 16rpx;
}

.goods-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
}

.goods-sku {
  font-size: 22rpx;
  color: var(--text-muted);
  line-height: 1.3;
}

.goods-unit-price {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.goods-right {
  align-items: flex-end;
  min-height: 130rpx;
  justify-content: space-between;
}

.goods-subtotal {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
}

/* 优惠券选择卡片 */
.coupon-select-card {
  padding: 24rpx 28rpx;
}

.coupon-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.coupon-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

.coupon-selected-text {
  font-size: 26rpx;
}

.arrow-right {
  font-size: 28rpx;
  color: var(--text-muted);
  margin-left: 6rpx;
}

/* 备注卡片 */
.remark-card {
  padding: 24rpx 28rpx;
}

.remark-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  width: 150rpx;
}

.remark-input {
  flex: 1;
  font-size: 26rpx;
  text-align: right;
  color: var(--text-main);
}

/* 发票卡片 */
.invoice-section-card {
  padding: 24rpx 28rpx;
}

.invoice-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.invoice-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

.invoice-form-box {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed #f1f5f9;
}

.invoice-type-group {
  margin-bottom: 16rpx;
  font-size: 26rpx;
}

.invoice-input {
  background-color: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  font-size: 26rpx;
  margin-bottom: 14rpx;
}

/* 金额明细卡片 */
.amount-row {
  margin-bottom: 18rpx;
  font-size: 26rpx;
}

.amount-label {
  color: var(--text-secondary);
}

.amount-value {
  font-weight: 600;
  color: var(--text-main);
}

.text-free {
  color: var(--secondary-color);
}

.text-discount {
  color: var(--danger-color);
}

.amount-divider {
  height: 1rpx;
  background-color: #f1f5f9;
  margin: 20rpx 0;
}

.amount-total-row {
  align-items: center;
}

.total-label {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-main);
}

/* 底部固定支付操作栏 */
.checkout-footer-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #ffffff;
  border-top: 1rpx solid #e2e8f0;
  z-index: 100;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.checkout-footer {
  padding: 16rpx 28rpx;
}

.footer-price-info {
  align-items: baseline;
}

.pay-text {
  font-size: 26rpx;
  color: var(--text-secondary);
  margin-right: 8rpx;
}

.discount-tip {
  font-size: 20rpx;
  color: var(--danger-color);
  background-color: #fef2f2;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  margin-left: 12rpx;
}

.btn-submit-pay {
  font-size: 30rpx;
  font-weight: 700;
  padding: 18rpx 54rpx;
  border-radius: 44rpx;
}

/* 优惠券弹窗 */
.coupon-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  z-index: 110;
}

.coupon-modal-content {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #f8fafc;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 120;
  padding: 30rpx;
  max-height: 70vh;
}

.coupon-modal-header {
  padding-bottom: 20rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
}

.modal-close {
  font-size: 32rpx;
  color: var(--text-muted);
}

.coupon-scroll-list {
  max-height: 55vh;
  padding: 10rpx 0;
}

.coupon-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid transparent;
}

.coupon-card.selected {
  border-color: var(--primary-color);
  background-color: #fffaf5;
}

.coupon-card.disabled {
  opacity: 0.5;
}

.coupon-amount-box {
  min-width: 120rpx;
  padding-right: 16rpx;
  border-right: 1rpx dashed #e2e8f0;
}

.coupon-amount-num {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--primary-color);
}

.coupon-type-tag {
  font-size: 20rpx;
  color: var(--text-muted);
}

.coupon-info {
  padding-left: 20rpx;
}

.coupon-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-main);
}

.coupon-condition {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

.coupon-expiry {
  font-size: 20rpx;
  color: var(--text-muted);
  margin-top: 4rpx;
}

.check-icon {
  font-size: 32rpx;
  color: var(--primary-color);
  font-weight: 800;
}

.unusable-text {
  font-size: 22rpx;
  color: var(--text-muted);
}

.no-coupon-text {
  font-size: 28rpx;
  color: var(--text-secondary);
}
